# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database (set DB_ENGINE=postgresql for production)
DB_ENGINE=postgresql
DB_NAME=tcg_marketplace
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Pokemon TCG API (get key from https://pokemontcg.io/)
POKEMON_TCG_API_KEY=your-api-key-here
